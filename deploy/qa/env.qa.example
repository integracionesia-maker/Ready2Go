# Plantilla del .env del QA. Se instala como /opt/go/gocreate-qa/shared/env/.env
# (permisos 600, dueño _gocreateqa). alta_host.sh lo genera desde aqui y fija un
# JWT_SECRET_KEY NUEVO con openssl; NUNCA se copia nada del .env de produccion.
#
# (Se llama env.qa.example y no .env.qa.example porque el .gitignore del repo
# ignora `.env.*` salvo `.env.example`.)
#
# ENV=production A PROPOSITO: con cualquier otro valor las cookies pierden
# `Secure` y /docs queda expuesto (ver backend/app/main.py). Lo que identifica al
# QA es QA_MODE, no ENV.
ENV=production
QA_MODE=true

# Secreto propio del QA (QA-03). alta_host.sh sustituye este valor.
JWT_SECRET_KEY=__GENERADO_EN_EL_SERVIDOR__
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Origen del QA (mismo valor que el hostname del tunel).
CORS_ORIGINS=https://qa.gocreate.mx
APP_PUBLIC_URL=https://qa.gocreate.mx

# Correo: APAGADO (QA-09). Con false no se abre ningun socket; el sistema solo
# registra el aviso en notification_log. SMTP_* y SMTP_BCC quedan AUSENTES a
# proposito: sin servidor no hay forma de que salga correo, ni siquiera por error.
NOTIF_ENABLED=false

# DATABASE_URL no se define: el default (sqlite:///./presupuesto.db) cae en el
# symlink backend/presupuesto.db -> /opt/go/gocreate-qa/shared/data/ (QA-01).
