# GOCreate — Variables de entorno
# Copiar a .env y reemplazar los valores con los reales.

# JWT — generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambiar-por-token-hex-32-generado-con-secrets
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Entorno: development | production
# En production se deshabilitan /docs y /redoc, y las cookies usan Secure.
ENV=development

# Credenciales del superadmin inicial (solo para seed_auth.py)
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=admin@gocreate.com
SUPERADMIN_PASSWORD=Admin123!

# Contraseña por defecto para usuarios creados con seed_usuarios_mkt.py
DEFAULT_USER_PASSWORD=Marketing2026!
