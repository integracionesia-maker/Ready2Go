# Estilo común entre editores (lote de calidad 2026-08-18): con 3 personas
# en 3 ramas, sin esto cada editor guarda con su propio charset/EOL y los
# diffs se llenan de ruido.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
